<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Login, signup and reset-password.

        web.login, auth_signup.signup and auth_signup.reset_password
        every one of them t-calls web.login_layout, which in turn t-calls
        web.frontend_layout, so the two templates below cover all three
        pages between them. That is also why the manifest does not depend
        on auth_signup — the templates being extended live in web, and
        the signup pages pick the styling up if and only if that module
        happens to be installed.

        Two templates, because the login page has two layouts:

          auth_theme_frontend_layout — everything that has to survive
            `website` being installed (the scope class, the saved
            colours, dark mode), plus the branding for that layout.

          auth_theme_login_layout — the branding inside the stock card,
            which only exists when `website` is absent.

        The long comment on the first one explains why the split is
        necessary rather than tidy.
    -->
    <!--
        ════════════════════════════════════════════════════════════
        The page chrome: scope class, saved colours, dark mode.
        ════════════════════════════════════════════════════════════

        On web.frontend_layout, not on web.login_layout, and that is the
        whole point.

        `website` ships this (website/views/website_templates.xml):

            <template id="login_layout" inherit_id="web.login_layout"
                      priority="20">
                <xpath expr="t" position="replace">
                    <t t-call="website.layout">
                        <div class="oe_website_login_container" t-out="0"/>
                    </t>
                </xpath>
            </template>

        — a `replace` of the *root* node, at a priority above this
        module's. Anything an inherit of web.login_layout adds is applied
        first and then discarded wholesale: the scope class, the two
        colour blocks and the dark-mode script all vanished, the
        stylesheet stopped matching, and the login page came back in
        website's own palette. That is the bug this template fixes.

        web.frontend_layout is the one node both roads pass through:
        website.layout is an inherit of portal.frontend_layout, which is
        an inherit of web.frontend_layout, so a change here lands whether
        or not `website` is installed — and no dependency on `website` is
        needed to make it.

        The cost is that this template is also evaluated for every portal
        and website page, so everything below is gated on
        `cmt_is_auth_page`. Nothing but the three cheap t-set lines runs
        anywhere else.
    -->
    <template id="auth_theme_frontend_layout" inherit_id="web.frontend_layout"
              name="BlueNova Themed Auth Pages (layout)">

        <!--
            Before <html>, so they are in scope for <body> and for
            everything nested under it. The same spot website.layout uses
            for its own html_data block.

            Matched on the path rather than on a flag from the caller
            because there is no caller to ask: by the time website's
            replace has run, web.login_layout no longer sets a single
            variable this template could key on. `/web/login` also covers
            `/web/login_successful`, which is themed for the same reason
            the other three are.
        -->
        <xpath expr="//html" position="before">
            <t t-set="cmt_auth_path" t-value="request.httprequest.path or ''"/>
            <t t-set="cmt_is_auth_page"
               t-value="'/web/login' in cmt_auth_path
                        or '/web/signup' in cmt_auth_path
                        or '/web/reset_password' in cmt_auth_path"/>
            <!--
                Set unconditionally, not inside a t-if: it is read from
                the <body> expression below, and a conditional expression
                that names an undefined variable in its unused branch is
                still a variable this template has to be able to resolve.
                `'website' in request.env` is a registry lookup, not a
                query — the same test controllers/main.py uses.
            -->
            <t t-set="cmt_auth_website"
               t-value="cmt_is_auth_page and 'website' in request.env"/>
        </xpath>

        <!--
            1. The scope class.

            Everything auth_pages.scss styles hangs off o_bluenova_auth_page,
            so the stylesheet can never leak into the backend — or, now,
            into the rest of the website — even though both share the same
            token names. It goes on <body> rather than on a wrapper div so
            the page background can be styled too.

            Added to whatever the caller set rather than replacing it:
            web.login_layout's own 'bg-100' has to survive, because the
            card and the body are both styled against it downstream.

            o_bluenova_auth_website is the marker for the second layout.
            CSS cannot ask "is my parent the website container", so the
            question is answered once here and the website-only rules in
            auth_pages.scss key on the result.
        -->
        <xpath expr="//body" position="attributes">
            <attribute name="t-att-class">((body_classname or '') + ' o_bluenova_auth_page' + (' o_bluenova_auth_website' if cmt_auth_website else '')) if cmt_is_auth_page else body_classname</attribute>
        </xpath>

        <!--
            Both blocks go in <body>, ahead of the page itself: the style
            has to beat the compiled bundles (it does, on document order —
            they are in <head>), and the script has to run before the page
            is painted.
        -->
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <t t-if="cmt_is_auth_page">
                <!--
                    2. The colours saved under Settings > Theme Settings.

                    The same _get_theme_css() the backend head uses (see
                    views/theme_styles.xml), rendered here because the
                    login page never loads web.webclient_bootstrap.
                    request.env is available on this unauthenticated
                    request: ensure_db() has already run by the time the
                    controller renders, and this very template calls
                    request.env itself for the session info.
                -->
                <t t-set="cmt_settings" t-value="request.env['res.config.settings'].sudo()"/>
                <t t-set="cmt_theme_css" t-value="cmt_settings._get_theme_css()"/>
                <style t-if="cmt_theme_css" type="text/css" t-out="cmt_theme_css"/>

                <!--
                    And the dark block. Its selector is the exact opposite
                    of the light one, so only ever one of the two matches;
                    the script below decides which by setting the
                    attribute.
                -->
                <t t-set="cmt_theme_css_dark" t-value="cmt_settings._get_theme_css_dark()"/>
                <style t-if="cmt_theme_css_dark" type="text/css" t-out="cmt_theme_css_dark"/>

                <!--
                    3. Dark mode, before the first paint.

                    static/src/js/theme_mode.js cannot do this job here:
                    it is in web.assets_backend, which the login page
                    never loads, and the frontend bundle is deferred
                    anyway — a module lands after the page has already
                    been painted light and the card would visibly flip.
                    This reads the same localStorage key that file writes
                    ('cmt_color_scheme') and sets the same attribute
                    auth_pages.scss keys on. Kept inline and kept tiny for
                    that reason.
                -->
                <script type="text/javascript">
                    try {
                        if (window.localStorage.getItem('cmt_color_scheme') === 'dark') {
                            document.documentElement.setAttribute('data-cmt-theme', 'dark');
                        }
                    } catch (e) {
                        /* private browsing: no stored preference, stay light */
                    }
                </script>
            </t>
        </xpath>

        <!--
            4. Branding, for the website layout only.

            website's replace does not just restyle the card, it deletes
            it: the logo block, the heading and the hairlines all lived in
            web.login_layout's markup, and what reaches the browser is a
            bare <div class="oe_website_login_container"> holding the
            form. The container is opaque to inheritance — its contents
            are a t-out of the calling template — so the heading cannot be
            put back inside it, and it is emitted here as an immediately
            preceding sibling instead. auth_pages.scss then draws the two
            as one card, which is why they must stay adjacent.

            Same xpath portal.frontend_layout uses for its own banner, so
            it is a node both this module and core rely on.

            The company logo is deliberately *not* repeated. website's
            header is right above this block and already carries it; the
            uploaded brand image is shown because putting it here is an
            explicit choice an admin made on the settings screen.
        -->
        <xpath expr="//div[@id='wrapwrap']/main/t[@t-out='0']" position="before">
            <t t-if="cmt_auth_website">
                <div class="o_bluenova_auth_website_head">
                    <t t-set="cmt_branding"
                       t-value="request.env['res.config.settings'].sudo()._get_auth_branding()"/>
                    <img t-if="cmt_branding['logo_url']" class="o_bluenova_auth_logo"
                         t-att-src="cmt_branding['logo_url']" alt="Logo"/>

                    <t t-if="'reset_password' in cmt_auth_path">
                        <h1 class="o_bluenova_auth_heading">Reset Password</h1>
                        <p class="o_bluenova_auth_lede">Please enter your details to reset your password</p>
                    </t>
                    <t t-elif="'signup' in cmt_auth_path">
                        <h1 class="o_bluenova_auth_heading">Create your account</h1>
                        <p class="o_bluenova_auth_lede">Please enter your details to get started</p>
                    </t>
                    <t t-elif="'login' in cmt_auth_path">
                        <h1 class="o_bluenova_auth_heading">Welcome back</h1>
                        <p class="o_bluenova_auth_lede">Please enter your details to sign in</p>
                    </t>

                    <!--
                        t-out on a plain string, never Markup: it is
                        admin-entered free text and lands on a page served
                        to anonymous visitors, so it is escaped.
                    -->
                    <div t-if="cmt_branding['tagline']" class="o_bluenova_auth_tagline">
                        <t t-out="cmt_branding['tagline']"/>
                    </div>
                </div>
            </t>
        </xpath>

    </template>

    <template id="auth_theme_login_layout" inherit_id="web.login_layout"
              name="BlueNova Themed Auth Pages">

        <!--
            Branding, for the stock layout.

            The uploaded sidebar brand image doubles as the login logo, so
            one upload dresses both surfaces. _get_auth_branding() returns
            logo_url = False when nothing is uploaded or the admin has
            turned the image off, and the original company logo is kept in
            that case — an untouched install still shows exactly what it
            showed before.

            The tagline is t-out on a plain string, never Markup: it is
            admin-entered free text and lands on a page served to
            anonymous visitors, so it is escaped.
        -->
        <!--
            Selected on @t-attf-src, not on @alt.

            `alt` is translatable, and Odoo refuses to let view
            inheritance key on a translated attribute (TRANSLATED_ATTRS
            in odoo/tools/translate.py — it also covers t-attf-alt,
            title, placeholder and the aria-* pair): the selector would
            stop matching the moment the parent view was translated.
            web.login_layout carries exactly one <img>, and t-attf-src is
            on it, so this picks the same node and survives translation.
        -->
        <xpath expr="//img[@t-attf-src]" position="replace">
            <!--
                Its own lookup, rather than a variable from
                auth_theme_frontend_layout.

                This markup is web.login_layout's, and web.login_layout
                t-calls web.frontend_layout — so the template that holds
                cmt_settings is the callee here, not the caller. QWeb
                renders a t-call body in the *caller's* scope; nothing the
                callee sets is visible to it, whichever order the two
                appear in the file.
            -->
            <t t-set="cmt_settings" t-value="request.env['res.config.settings'].sudo()"/>
            <t t-set="cmt_branding" t-value="cmt_settings._get_auth_branding()"/>
            <img t-if="cmt_branding['logo_url']" class="o_bluenova_auth_logo"
                 t-att-src="cmt_branding['logo_url']" alt="Logo"/>
            <img t-else="" class="o_bluenova_auth_logo"
                 t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                 alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>

            <!--
                The heading, per the reference design.

                All three pages share this one template, so which
                heading to show has to come from the request path —
                web.login_layout has no idea which of its three callers
                is rendering it, and the two signup templates live in
                auth_signup, a module this one deliberately does not
                depend on.

                Falls back to nothing rather than to "Welcome back" on an
                unrecognised path: a heading is better absent than wrong,
                and another module could route a fourth page through this
                same layout.
            -->
            <t t-set="cmt_path" t-value="request.httprequest.path or ''"/>
            <t t-if="'reset_password' in cmt_path">
                <h1 class="o_bluenova_auth_heading">Reset Password</h1>
                <p class="o_bluenova_auth_lede">Please enter your details to reset your password</p>
            </t>
            <t t-elif="'signup' in cmt_path">
                <h1 class="o_bluenova_auth_heading">Create your account</h1>
                <p class="o_bluenova_auth_lede">Please enter your details to get started</p>
            </t>
            <t t-elif="'login' in cmt_path">
                <h1 class="o_bluenova_auth_heading">Welcome back</h1>
                <p class="o_bluenova_auth_lede">Please enter your details to sign in</p>
            </t>

            <div t-if="cmt_branding['tagline']" class="o_bluenova_auth_tagline">
                <t t-out="cmt_branding['tagline']"/>
            </div>
        </xpath>

    </template>

</odoo>
